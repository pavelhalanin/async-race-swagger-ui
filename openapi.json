{
  "openapi": "3.0.4",
  "info": {
    "title": "Документация API",
    "description": "Документация API в виде SwaggerUI через конфиг OpenAPI 3.0",
    "version": "2026.08.19"
  },
  "externalDocs": {
    "description": "Документация API Async Race в Markdown",
    "url": "https://github.com/mikhama/async-race-api"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Локальный backend сервер"
    }
  ],
  "tags": [
    {
      "name": "Garage",
      "description": "Garagee"
    }
  ],
  "paths": {
    "/garage": {
      "get": {
        "tags": ["Garage"],
        "summary": "Get Cars",
        "description": "Возвращает JSON-данные об автомобилях в гараже.",
        "parameters": [
          {
            "name": "_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Номер страницы (пагинация)"
          },
          {
            "name": "_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Количество записей на странице. Если передан, в ответе возвращается заголовок X-Total-Count с общим количеством записей."
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ. Возвращает массив автомобилей.",
            "headers": {
              "X-Total-Count": {
                "description": "Общее количество записей (возвращается только если передан параметр _limit)",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Название автомобиля",
                        "example": "Tesla"
                      },
                      "color": {
                        "type": "string",
                        "description": "Цвет автомобиля в HEX-формате",
                        "example": "#e6e6fa"
                      },
                      "id": {
                        "type": "integer",
                        "description": "Уникальный идентификатор автомобиля",
                        "example": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, некорректные параметры)"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      },
      "post": {
        "tags": ["Garage"],
        "summary": "Create Car",
        "description": "Создаёт новый автомобиль в гараже.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "color"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Название автомобиля",
                    "example": "New Red Car"
                  },
                  "color": {
                    "type": "string",
                    "description": "Цвет автомобиля в HEX-формате",
                    "example": "#ff0000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Автомобиль успешно создан. Возвращает данные созданного автомобиля.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Название автомобиля",
                      "example": "New Red Car"
                    },
                    "color": {
                      "type": "string",
                      "description": "Цвет автомобиля в HEX-формате",
                      "example": "#ff0000"
                    },
                    "id": {
                      "type": "integer",
                      "description": "Уникальный идентификатор созданного автомобиля",
                      "example": 10
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, отсутствуют обязательные поля или некорректный формат данных)"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    },
    "/garage/{id}": {
      "get": {
        "tags": ["Garage"],
        "summary": "Get Car",
        "description": "Возвращает JSON-данные об указанном автомобиле.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Уникальный идентификатор автомобиля"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ. Возвращает данные об автомобиле.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Название автомобиля",
                      "example": "Tesla"
                    },
                    "color": {
                      "type": "string",
                      "description": "Цвет автомобиля в HEX-формате",
                      "example": "#e6e6fa"
                    },
                    "id": {
                      "type": "integer",
                      "description": "Уникальный идентификатор автомобиля",
                      "example": 1
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Автомобиль с указанным ID не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Garage"],
        "summary": "Delete Car",
        "description": "Удаляет указанный автомобиль из гаража.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Уникальный идентификатор автомобиля"
          }
        ],
        "responses": {
          "200": {
            "description": "Автомобиль успешно удалён.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          },
          "404": {
            "description": "Автомобиль с указанным ID не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    }
  }
}
