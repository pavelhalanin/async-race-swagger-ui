{
  "openapi": "3.0.4",
  "info": {
    "title": "Документация API",
    "description": "Документация API в виде SwaggerUI через конфиг OpenAPI 3.0",
    "version": "2026.08.19"
  },
  "externalDocs": {
    "description": "Оригинальная документация в Markdown",
    "url": "https://github.com/mikhama/async-race-api#usage"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Локальный backend сервер"
    }
  ],
  "tags": [
    {
      "name": "Garage",
      "description": "Garage",
      "externalDocs": {
        "description": "Оригинальная документация в Markdown",
        "url": "https://github.com/mikhama/async-race-api#usage"
      }
    },
    {
      "name": "Engine",
      "description": "Engine",
      "externalDocs": {
        "description": "Оригинальная документация в Markdown",
        "url": "https://github.com/mikhama/async-race-api#usage"
      }
    }
  ],
  "paths": {
    "/garage": {
      "get": {
        "tags": ["Garage"],
        "summary": "Get Cars",
        "description": "Возвращает JSON-данные об автомобилях в гараже.",
        "externalDocs": {
          "description": "Оригинальная документация в Markdown",
          "url": "https://github.com/mikhama/async-race-api#get-cars"
        },
        "parameters": [
          {
            "name": "_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Номер страницы (пагинация)"
          },
          {
            "name": "_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Количество записей на странице. Если передан, в ответе возвращается заголовок X-Total-Count с общим количеством записей."
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ. Возвращает массив автомобилей.",
            "headers": {
              "X-Total-Count": {
                "description": "Общее количество записей (возвращается только если передан параметр _limit)",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Название автомобиля",
                        "example": "Tesla"
                      },
                      "color": {
                        "type": "string",
                        "description": "Цвет автомобиля в HEX-формате",
                        "example": "#e6e6fa"
                      },
                      "id": {
                        "type": "integer",
                        "description": "Уникальный идентификатор автомобиля",
                        "example": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, некорректные параметры)"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      },
      "post": {
        "tags": ["Garage"],
        "summary": "Create Car",
        "description": "Создаёт новый автомобиль в гараже.",
        "externalDocs": {
          "description": "Оригинальная документация в Markdown",
          "url": "https://github.com/mikhama/async-race-api#create-car"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "color"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Название автомобиля",
                    "example": "New Red Car"
                  },
                  "color": {
                    "type": "string",
                    "description": "Цвет автомобиля в HEX-формате",
                    "example": "#ff0000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Автомобиль успешно создан. Возвращает данные созданного автомобиля.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Название автомобиля",
                      "example": "New Red Car"
                    },
                    "color": {
                      "type": "string",
                      "description": "Цвет автомобиля в HEX-формате",
                      "example": "#ff0000"
                    },
                    "id": {
                      "type": "integer",
                      "description": "Уникальный идентификатор созданного автомобиля",
                      "example": 10
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, отсутствуют обязательные поля или некорректный формат данных)"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    },
    "/garage/{id}": {
      "get": {
        "tags": ["Garage"],
        "summary": "Get Car",
        "description": "Возвращает JSON-данные об указанном автомобиле.",
        "externalDocs": {
          "description": "Оригинальная документация в Markdown",
          "url": "https://github.com/mikhama/async-race-api#get-car"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Уникальный идентификатор автомобиля"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ. Возвращает данные об автомобиле.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Название автомобиля",
                      "example": "Tesla"
                    },
                    "color": {
                      "type": "string",
                      "description": "Цвет автомобиля в HEX-формате",
                      "example": "#e6e6fa"
                    },
                    "id": {
                      "type": "integer",
                      "description": "Уникальный идентификатор автомобиля",
                      "example": 1
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Автомобиль с указанным ID не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Garage"],
        "summary": "Update Car",
        "description": "Обновляет атрибуты указанного автомобиля.",
        "externalDocs": {
          "description": "Оригинальная документация в Markdown",
          "url": "https://github.com/mikhama/async-race-api#update-car"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Уникальный идентификатор автомобиля"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "color"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Новое название автомобиля",
                    "example": "Car with new name"
                  },
                  "color": {
                    "type": "string",
                    "description": "Новый цвет автомобиля в HEX-формате",
                    "example": "#ff00ff"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Автомобиль успешно обновлён. Возвращает обновлённые данные автомобиля.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Название автомобиля",
                      "example": "Car with new name"
                    },
                    "color": {
                      "type": "string",
                      "description": "Цвет автомобиля в HEX-формате",
                      "example": "#ff00ff"
                    },
                    "id": {
                      "type": "integer",
                      "description": "Уникальный идентификатор автомобиля",
                      "example": 2
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, отсутствуют обязательные поля или некорректный формат данных)"
          },
          "404": {
            "description": "Автомобиль с указанным ID не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      },
      "delete": {
        "tags": ["Garage"],
        "summary": "Delete Car",
        "description": "Удаляет указанный автомобиль из гаража.",
        "externalDocs": {
          "description": "Оригинальная документация в Markdown",
          "url": "https://github.com/mikhama/async-race-api#delete-car"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Уникальный идентификатор автомобиля"
          }
        ],
        "responses": {
          "200": {
            "description": "Автомобиль успешно удалён.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          },
          "404": {
            "description": "Автомобиль с указанным ID не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    },
    "/engine": {
      "patch": {
        "tags": ["Engine"],
        "summary": "Start / Stop Car's Engine",
        "description": "Запускает или останавливает двигатель указанного автомобиля и возвращает его актуальную скорость и расстояние.",
        "externalDocs": {
          "description": "Оригинальная документация в Markdown",
          "url": "https://github.com/mikhama/async-race-api#start--stop-cars-engine"
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Уникальный идентификатор автомобиля"
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["started", "stopped"]
            },
            "description": "Статус двигателя"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ. Возвращает скорость и расстояние.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "velocity": {
                      "type": "number",
                      "description": "Скорость автомобиля",
                      "example": 64
                    },
                    "distance": {
                      "type": "number",
                      "description": "Расстояние, которое проедет автомобиль",
                      "example": 500000
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, некорректные параметры)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "Wrong parameters: \"id\" should be any positive number, \"status\" should be \"started\", \"stopped\" or \"drive\""
                }
              }
            }
          },
          "404": {
            "description": "Автомобиль с указанным ID не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "Car with such id was not found in the garage."
                }
              }
            }
          }
        }
      }
    }
  }
}
